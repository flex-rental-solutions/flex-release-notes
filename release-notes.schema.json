{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flex What's New plan content",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "flag",
        "message"
      ],
      "properties": {
        "flag": {
          "type": "string",
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "version",
        "date",
        "notes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "announcement": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "highlight": {
          "type": "boolean"
        },
        "pinned": {
          "oneOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pin"
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "$comment": "Historical content includes non-semver labels and highlights without titles. Structural rules apply to all entries; proposedEntry adds current authoring rules for changes."
    },
    "proposedEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/entry"
        },
        {
          "if": {
            "properties": {
              "highlight": {
                "const": true
              }
            },
            "required": [
              "highlight"
            ]
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "highlight": {
                "const": true
              }
            },
            "required": [
              "highlight"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "not": {
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              }
            }
          },
          "else": {
            "properties": {
              "version": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "not": {
                  "pattern": "^0+\\.[0-9]+\\.0*[1-9][0-9]*$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
